# Database
DATABASE_URL="postgres://user:password@localhost:5432/database"

# Application
NODE_ENV="development"
NAME="Your School Name"
NEXT_PUBLIC_APP_NAME="Your Portal Name"
FRONTEND_URL="https://your-domain.com"
LOG_LEVEL="error"
PAGESIZE="10"

# JWT
JWTSECRET="your-jwt-secret-key-here"

# Redis Caching
# For production: Use your production Redis URL (e.g., Upstash, Redis Cloud, etc.)
# For development: Use local Redis (redis://localhost:6379)
REDIS_URL="redis://localhost:6379"

# Email
SENDGRID_API_KEY="your-sendgrid-api-key"
SUPPORT_EMAIL="support@yourdomain.com"
ADMISSION_EMAIL="admission@yourdomain.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"

# Payment Gateways
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
REMITA_PK="your-remita-public-key"
REMITA_SK="your-remita-secret-key"

# Encryption
EN_KEY="your-32-character-encryption-key"

# AI/LLM
OPENROUTER_LLM_KEY="your-openrouter-key"
OPENROUTER_LLM_MODEL="tngtech/deepseek-r1t2-chimera:free"
GROQ_KEY="your-groq-key"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_MODEL_LEARNING="llama-3.3-70b-versatile"
MISTRAL_KEY="your-mistral-key"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-auth"
GOOGLE_WORKSPACE_DOMAIN="yourdomain.com"

# Development
PORT=3000
DISABLE_API_AUTH=false
