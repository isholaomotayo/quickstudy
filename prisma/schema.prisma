generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model affiliate {
  id             BigInt   @id @default(autoincrement())
  user_id        BigInt?
  bank           String?  @db.VarChar(255)
  account_no     String?  @db.VarChar(255)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  affiliate_paid String[] @default([])
  user           user?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ai_conversations {
  id           Int       @id @default(autoincrement())
  user_id      String    @db.VarChar(255)
  context_id   Int?
  context_type String    @default("lesson") @db.VarChar(255)
  user_prompt  String
  ai_response  String
  lesson_data  Json?     @db.Json
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_created_at")
  @@index([user_id, context_id], map: "idx_user_context")
  @@index([user_id, created_at], map: "idx_user_created")
}

model announcement_reads {
  id              BigInt        @id @default(autoincrement())
  announcement_id BigInt
  user_id         BigInt
  institution_id  Int
  read_at         DateTime?     @default(now()) @db.Timestamptz(6)
  created_at      DateTime?     @db.Timestamptz(6)
  updated_at      DateTime?     @db.Timestamptz(6)
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "announcement_reads_announcement_id_foreign")
  institution     institution   @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "announcement_reads_institution_id_foreign")
  user            user          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "announcement_reads_user_id_foreign")

  @@unique([announcement_id, user_id], map: "announcement_reads_announcement_id_user_id_unique")
  @@index([announcement_id], map: "announcement_reads_announcement_id_index")
  @@index([user_id, announcement_id], map: "announcement_reads_user_id_announcement_id_index")
}

model announcements {
  id                 BigInt               @id @default(autoincrement())
  institution_id     Int
  user_id            BigInt
  title              String               @db.VarChar(255)
  body               String
  created_at         DateTime?            @db.Timestamptz(6)
  updated_at         DateTime?            @db.Timestamptz(6)
  announcement_reads announcement_reads[]
  institution        institution          @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               user                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model class_degree {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(255)
  code           String?       @db.VarChar(255)
  min_point      Decimal       @db.Decimal(8, 2)
  max_point      Decimal       @db.Decimal(8, 2)
  institution_id Int?
  institution    institution?  @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_gpa    student_gpa[]
}

model course {
  id                      Int                       @id @default(autoincrement())
  programme_id            Int?
  code                    String                    @db.VarChar(255)
  name                    String                    @db.VarChar(255)
  level_id                Int?
  units                   Int
  description             String?
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  semester_position       Int?
  department_id           Int?
  published               Boolean?                  @default(true)
  department              department?               @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level                   level?                    @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programme               programme?                @relation(fields: [programme_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course_announcement     course_announcement[]
  course_discussion_topic course_discussion_topic[]
  course_forum_topic      course_forum_topic[]
  course_meetings         course_meetings[]
  course_module           course_module[]
  course_progress         course_progress[]
  course_test             course_test[]
  programme_course        programme_course[]
  staff_course            staff_course[]
  student_course          student_course[]
}

model course_announcement {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  course_id  Int
  title      String    @db.VarChar(255)
  body       String
  created_at DateTime? @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  course     course    @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model course_discussion_comment {
  id                         BigInt                  @id @default(autoincrement())
  user_id                    BigInt
  course_discussion_topic_id BigInt
  body                       String?
  created_at                 DateTime?               @db.Timestamptz(6)
  updated_at                 DateTime?               @db.Timestamptz(6)
  course_discussion_topic    course_discussion_topic @relation(fields: [course_discussion_topic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                       user                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model course_discussion_topic {
  id                        BigInt                      @id @default(autoincrement())
  user_id                   BigInt
  course_id                 Int
  title                     String                      @db.VarChar(255)
  body                      String
  start_date                DateTime?                   @db.Timestamptz(6)
  end_date                  DateTime?                   @db.Timestamptz(6)
  created_at                DateTime?                   @db.Timestamptz(6)
  updated_at                DateTime?                   @db.Timestamptz(6)
  course_discussion_comment course_discussion_comment[]
  course                    course                      @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                      user                        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model course_forum_thread {
  id                    BigInt             @id @default(autoincrement())
  user_id               BigInt
  course_forum_topic_id BigInt
  body                  String?
  created_at            DateTime?          @db.Timestamptz(6)
  updated_at            DateTime?          @db.Timestamptz(6)
  course_forum_topic    course_forum_topic @relation(fields: [course_forum_topic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                  user               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model course_forum_topic {
  id                  BigInt                @id @default(autoincrement())
  user_id             BigInt
  course_id           Int
  title               String                @db.VarChar(255)
  description         String
  created_at          DateTime?             @db.Timestamptz(6)
  updated_at          DateTime?             @db.Timestamptz(6)
  course_forum_thread course_forum_thread[]
  course              course                @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                user                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model course_lesson {
  id                                                               Int               @id @default(autoincrement())
  course_module_id                                                 Int?
  name                                                             String            @db.VarChar(255)
  order                                                            Int
  description                                                      String?
  created_at                                                       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                                                       DateTime          @default(now()) @db.Timestamptz(6)
  content                                                          String            @default("")
  course_module                                                    course_module?    @relation(fields: [course_module_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course_progress_course_progress_current_lesson_idTocourse_lesson course_progress[] @relation("course_progress_current_lesson_idTocourse_lesson")
  course_progress_course_progress_last_lesson_idTocourse_lesson    course_progress[] @relation("course_progress_last_lesson_idTocourse_lesson")
  course_test                                                      course_test[]

  // New relations for practice questions
  practice_questions practice_question[]
  practice_sessions  practice_session[]
}

model course_meetings {
  id               Int       @id @default(autoincrement())
  course_id        Int
  course_code      String    @db.VarChar(255)
  meeting_provider String    @db.VarChar(255)
  meeting_url      String    @db.VarChar(255)
  meeting_id       String?   @db.VarChar(255)
  meeting_data     String?
  is_active        Boolean?  @default(true)
  is_persistent    Boolean?  @default(false)
  expires_at       DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  course           course    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_meetings_course_id_foreign")

  @@index([course_code], map: "course_meetings_course_code_index")
  @@index([course_id], map: "course_meetings_course_id_index")
  @@index([is_active], map: "course_meetings_is_active_index")
  @@index([meeting_provider], map: "course_meetings_meeting_provider_index")
}

model course_module {
  id              Int               @id @default(autoincrement())
  course_id       Int?
  name            String            @db.VarChar(255)
  order           Int
  description     String?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  published       Boolean?          @default(true)
  course_lesson   course_lesson[]
  course          course?           @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course_progress course_progress[]
  course_test     course_test[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_progress {
  id                                                             Int            @id @default(autoincrement())
  student_id                                                     BigInt
  course_id                                                      Int
  course_module_id                                               Int?
  institution_id                                                 Int
  progress_data                                                  Json?          @db.Json
  user_preferences                                               Json?          @db.Json
  total_lessons                                                  Int?           @default(0)
  completed_lessons                                              Int?           @default(0)
  completion_percentage                                          Decimal?       @default(0) @db.Decimal(5, 2)
  current_lesson_id                                              Int?
  last_lesson_id                                                 Int?
  status                                                         String?        @default("not_started")
  started_at                                                     DateTime?      @db.Timestamptz(6)
  completed_at                                                   DateTime?      @db.Timestamptz(6)
  last_accessed_at                                               DateTime?      @db.Timestamptz(6)
  total_time_minutes                                             Int?           @default(0)
  session_count                                                  Int?           @default(0)
  created_at                                                     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                                                     DateTime       @default(now()) @db.Timestamptz(6)
  course                                                         course         @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_progress_course_id_foreign")
  course_module                                                  course_module? @relation(fields: [course_module_id], references: [id], onUpdate: NoAction, map: "course_progress_course_module_id_foreign")
  course_lesson_course_progress_current_lesson_idTocourse_lesson course_lesson? @relation("course_progress_current_lesson_idTocourse_lesson", fields: [current_lesson_id], references: [id], onUpdate: NoAction, map: "course_progress_current_lesson_id_foreign")
  institution                                                    institution    @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_progress_institution_id_foreign")
  course_lesson_course_progress_last_lesson_idTocourse_lesson    course_lesson? @relation("course_progress_last_lesson_idTocourse_lesson", fields: [last_lesson_id], references: [id], onUpdate: NoAction, map: "course_progress_last_lesson_id_foreign")
  student                                                        student        @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_progress_student_id_foreign")

  @@unique([student_id, course_id], map: "course_progress_student_id_course_id_unique")
  @@index([completion_percentage], map: "course_progress_completion_percentage_index")
  @@index([course_id, status], map: "course_progress_course_id_status_index")
  @@index([institution_id], map: "course_progress_institution_id_index")
  @@index([last_accessed_at], map: "course_progress_last_accessed_at_index")
  @@index([student_id, status], map: "course_progress_student_id_status_index")
}

model course_question {
  id             Int          @id @default(autoincrement())
  course_test_id Int?
  question       String       @db.VarChar(255)
  details        String?
  options        Json?        @db.Json
  answer         String?      @default("") @db.VarChar(255)
  order          Int
  marks          Int          @default(1)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  course_test    course_test? @relation(fields: [course_test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_test {
  id               Int               @id @default(autoincrement())
  course_id        Int?
  course_module_id Int?
  course_lesson_id Int?
  name             String            @db.VarChar(255)
  instructions     String?
  duration_mins    Int?
  deadline         DateTime?         @db.Timestamptz(6)
  max_attempts     Int?              @default(1)
  max_score        Int?              @default(0)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  format           String            @default("")
  published        Boolean?          @default(true)
  course_question  course_question[]
  course           course?           @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course_lesson    course_lesson?    @relation(fields: [course_lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course_module    course_module?    @relation(fields: [course_module_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_test     student_test[]
}

model department {
  id           Int            @id @default(autoincrement())
  faculty_id   Int?
  code         String         @db.VarChar(255)
  name         String         @db.VarChar(255)
  email        String?        @db.VarChar(255)
  phone        String?        @db.VarChar(255)
  description  String?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  course       course[]
  faculty      faculty?       @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fee          fee[]
  payment2     payment2[]
  programme    programme[]
  staff        staff[]
  student_test student_test[]
}

model faculty {
  id             Int          @id @default(autoincrement())
  institution_id Int?
  name           String       @db.VarChar(255)
  email          String?      @db.VarChar(255)
  phone          String?      @db.VarChar(255)
  description    String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  department     department[]
  institution    institution? @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fee            fee[]
}

model fee {
  id                        BigInt       @id @default(autoincrement())
  name                      String       @db.VarChar(255)
  description               String?      @db.VarChar(255)
  amount                    Decimal?     @db.Decimal(8, 2)
  optional                  Int?
  frequency                 Int?
  compulsory                Int?
  institution_id            Int?
  session_id                Int?
  faculty_id                Int?
  department_id             Int?
  programme_id              Int?
  level_id                  Int?
  created_at                DateTime?    @db.Timestamptz(6)
  updated_at                DateTime?    @db.Timestamptz(6)
  created_by                BigInt?
  updated_by                BigInt?
  active                    Boolean      @default(true)
  monthly                   Decimal?     @db.Decimal(20, 2)
  monthly_parts             Int?         @default(0)
  semesterly                Decimal?     @db.Decimal(20, 2)
  semesterly_parts          Int?         @default(0)
  sessionly                 Decimal?     @db.Decimal(20, 2)
  sessionly_parts           Int?         @default(0)
  user_fee_created_byTouser user?        @relation("fee_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department                department?  @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty                   faculty?     @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution               institution? @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level                     level?       @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programme                 programme?   @relation(fields: [programme_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session                   session?     @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_fee_updated_byTouser user?        @relation("fee_updated_byTouser", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model grade {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  weight         Int?
  min_score      Int?
  max_score      Int?
  institution_id Int?
  point          Decimal?         @default(0) @db.Decimal(3, 2)
  institution    institution?     @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_result student_result[]
}

model institution {
  id                                    Int                  @id @default(autoincrement())
  code                                  String               @db.VarChar(255)
  name                                  String               @db.VarChar(255)
  address                               String               @db.VarChar(255)
  email                                 String               @db.VarChar(255)
  phone                                 String               @db.VarChar(255)
  motto                                 String?              @db.VarChar(255)
  website                               String?              @db.VarChar(255)
  twitter                               String?              @db.VarChar(255)
  facebook                              String?              @db.VarChar(255)
  youtube                               String?              @db.VarChar(255)
  description                           String?
  created_at                            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime             @default(now()) @db.Timestamptz(6)
  created_by                            BigInt?
  updated_by                            BigInt?
  logo                                  String?              @db.VarChar(255)
  host_name                             String?              @db.VarChar(255)
  support_mail                          String?              @db.VarChar(255)
  admission_mail                        String?              @db.VarChar(255)
  school_calendar                       String?              @db.VarChar(255)
  director_signature                    String?              @db.VarChar(255)
  paywall_on                            Boolean?             @default(false)
  id_card                               Json?                @db.Json
  token                                 String?
  calendar_data                         Json?                @db.Json
  announcement_reads                    announcement_reads[]
  announcements                         announcements[]
  class_degree                          class_degree[]
  course_progress                       course_progress[]
  faculty                               faculty[]
  fee                                   fee[]
  grade                                 grade[]
  user_institution_created_byTouser     user?                @relation("institution_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_institution_updated_byTouser     user?                @relation("institution_updated_byTouser", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level                                 level[]
  payment2                              payment2[]
  payment_account                       payment_account[]
  semester                              semester[]
  session                               session[]
  student_test                          student_test[]
  user_user_institution_idToinstitution user[]               @relation("user_institution_idToinstitution")
}

model knex_migrations {
  id             Int       @id @default(autoincrement())
  name           String?   @db.VarChar(255)
  batch          Int?
  migration_time DateTime? @db.Timestamptz(6)
}

model knex_migrations_lock {
  index     Int  @id @default(autoincrement())
  is_locked Int?
}

model level {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  description      String?            @default("") @db.VarChar(255)
  institution_id   Int?               @default(1)
  course           course[]
  fee              fee[]
  institution      institution?       @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "level_institution_id_foreign")
  programme_course programme_course[]
  student          student[]

  @@index([institution_id], map: "level_institution_id_index")
}

model payment2 {
  id                 Int          @id @default(autoincrement())
  student_id         BigInt
  amount             Decimal      @db.Decimal(20, 2)
  cart               Json?        @db.Json
  institution_id     Int?
  department_id      Int?
  processor          String?      @db.VarChar(255)
  reference          String?      @db.VarChar(255)
  ip                 String?      @db.VarChar(255)
  status             Int?         @default(0)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime     @default(now()) @db.Timestamptz(6)
  paid_at            DateTime?    @db.Timestamptz(6)
  channel            String?      @db.VarChar(255)
  processor_currency String?      @db.VarChar(255)
  processor_status   String?      @db.VarChar(255)
  department         department?  @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution        institution? @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student            student      @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model payment_account {
  id              BigInt       @id @default(autoincrement())
  institution_id  Int?
  merchant_id     String?      @db.VarChar(255)
  terminal_id     String?      @db.VarChar(255)
  secret_key      String?      @db.VarChar(255)
  public_key      String?      @db.VarChar(255)
  created_at      DateTime?    @db.Timestamptz(6)
  updated_at      DateTime?    @db.Timestamptz(6)
  test_secret_key String?      @db.VarChar(255)
  test_public_key String?      @db.VarChar(255)
  institution     institution? @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model programme {
  id               Int                @id @default(autoincrement())
  department_id    Int?
  name             String             @db.VarChar(255)
  years            Int
  prefix           String?            @db.VarChar(255)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  regno_format     String?            @default("") @db.VarChar(255)
  course           course[]
  fee              fee[]
  department       department?        @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programme_course programme_course[]
  student          student[]
}

model programme_course {
  id                Int        @id @default(autoincrement())
  programme_id      Int?
  course_id         Int?
  level_id          Int?
  units             Int?
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime   @default(now()) @db.Timestamptz(6)
  semester_position Int?
  course            course?    @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
